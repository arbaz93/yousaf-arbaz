---
import CaseStudyImage from "@/components/case-study/CaseStudyImage.astro";

interface Feature {
  title: string;
  description: string;
  image?: string | null;
}

interface WorkflowStep {
  step: string;
  title: string;
  description: string;
}

interface ArchitectureItem {
  name: string;
  technologies: string[];
}

interface ChallengeItem {
  title: string;
  description: string;
}

export type CaseStudy = {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  status: string;
  links: {
    live?: string | null;
    github?: string | null;
  };
  heroImage?: string | null;
  overview: {
    description: string;
    role: string;
  };
  challenge: {
    title: string;
    description: string;
  };
  solution: {
    title: string;
    description: string;
  };
  features: Feature[];
  workflow: WorkflowStep[];
  screenshots?: Array<{ title: string; image?: string | null }>;
  architecture: {
    description: string;
    items: ArchitectureItem[];
  };
  challenges: ChallengeItem[];
  result: {
    title: string;
    description: string;
  };
  learnings: {
    title: string;
    description: string;
  };
};

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props as Props;

const heroImage = caseStudy.heroImage?.trim() ? caseStudy.heroImage : null;
const hasScreenshots = caseStudy.screenshots?.some(
  (screenshot: { image?: string | null }) =>
    Boolean(screenshot.image && screenshot.image.trim())
);
---

<section class="mx-auto max-w-6xl px-4 pb-16 pt-24 sm:px-6 lg:px-8">
  <div class="mb-8 pt-2">
    <a
      href="/#projects"
      class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] transition-colors hover:text-[var(--white)]"
      aria-label="Back to projects"
    >
      <span aria-hidden="true">←</span>
      <span>Back to projects</span>
    </a>
  </div>

  <header class="border border-[#ffffff10] bg-[#101010] px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
          Case study
        </p>
        <h1 class="text-4xl font-medium tracking-tight text-[var(--white)] md:text-5xl">
          {caseStudy.title}
        </h1>
        <p class="mt-4 text-xl text-[var(--white-icon)] md:text-2xl">
          {caseStudy.subtitle}
        </p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-[var(--white-icon)]">
          {caseStudy.description}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            caseStudy.links.live && (
              <a
                href={caseStudy.links.live}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full border border-[var(--white-icon-tr)] bg-[var(--white-icon-tr)] px-5 py-2.5 text-sm font-medium text-[var(--white)] transition-colors hover:bg-[var(--white-icon-tr)]"
              >
                View live demo
              </a>
            )
          }
          {
            caseStudy.links.github && (
              <a
                href={caseStudy.links.github}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full border border-[var(--white-icon-tr)] px-5 py-2.5 text-sm font-medium text-[var(--white-icon)] transition-colors hover:text-[var(--white)]"
              >
                View source code
              </a>
            )
          }
        </div>
      </div>

      {
        heroImage && (
          <div class="overflow-hidden rounded-2xl border border-[#ffffff10] bg-[#121212]">
            <CaseStudyImage
              src={heroImage}
              alt={`${caseStudy.title} hero preview`}
              imageClass="h-full w-full object-cover"
              triggerClass="h-full"
              loading="eager"
            />
          </div>
        )
      }
    </div>
  </header>

  <section class="mt-16 border-t border-[#ffffff10] pt-12">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
        Overview
      </p>
      <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">
        Context and scope
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-6">
        <p class="text-lg leading-relaxed text-[var(--white-icon)]">
          {caseStudy.overview.description}
        </p>
      </div>

      <dl class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-6 text-sm text-[var(--white-icon)]">
        <div class="mb-5">
          <dt class="text-xs uppercase tracking-[0.2em] text-[var(--sec)]">Role</dt>
          <dd class="mt-2 leading-relaxed text-[var(--white)]">{caseStudy.overview.role}</dd>
        </div>
        <div class="mb-5">
          <dt class="text-xs uppercase tracking-[0.2em] text-[var(--sec)]">Status</dt>
          <dd class="mt-2 text-[var(--white)]">{caseStudy.status}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.2em] text-[var(--sec)]">Links</dt>
          <dd class="mt-3 flex flex-wrap gap-3">
            {
              caseStudy.links.live && (
                <a href={caseStudy.links.live} target="_blank" rel="noreferrer" class="text-[var(--white)] underline-offset-4 hover:underline">
                  Live demo
                </a>
              )
            }
            {
              caseStudy.links.github && (
                <a href={caseStudy.links.github} target="_blank" rel="noreferrer" class="text-[var(--white)] underline-offset-4 hover:underline">
                  GitHub
                </a>
              )
            }
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mt-16 border-t border-[#ffffff10] pt-12">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
          {caseStudy.challenge.title}
        </p>
        <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">
          The problem
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-[var(--white-icon)]">
          {caseStudy.challenge.description}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
          {caseStudy.solution.title}
        </p>
        <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">
          The approach
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-[var(--white-icon)]">
          {caseStudy.solution.description}
        </p>
      </div>
    </div>
  </section>

  {
    caseStudy.features?.length > 0 && (
      <section class="mt-16 border-t border-[#ffffff10] pt-12">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Features</p>
          <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">What makes it work</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {caseStudy.features.map((feature) => (
            <article class="overflow-hidden rounded-2xl border border-[#ffffff10] bg-[#111111]">
              {feature.image && feature.image.trim() && (
                <CaseStudyImage
                  src={feature.image}
                  alt={feature.title}
                  imageClass="h-56 w-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                <h3 class="text-xl font-medium text-[var(--white)]">{feature.title}</h3>
                <p class="mt-3 text-base leading-relaxed text-[var(--white-icon)]">{feature.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    caseStudy.workflow?.length > 0 && (
      <section class="mt-16 border-t border-[#ffffff10] pt-12">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Workflow</p>
          <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">How it works</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
          {caseStudy.workflow.map((step) => (
            <div class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-5">
              <span class="text-sm font-semibold tracking-[0.2em] text-[var(--sec)]">{step.step}</span>
              <h3 class="mt-4 text-xl font-medium text-[var(--white)]">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--white-icon)]">{step.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    hasScreenshots && (
      <section class="mt-16 border-t border-[#ffffff10] pt-12">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Screenshots</p>
          <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">Project snapshots</h2>
        </div>

        <div class="case-study-gallery" aria-label="Project screenshots gallery">
          {caseStudy.screenshots
            ?.filter(
              (screenshot): screenshot is { title: string; image: string } =>
                Boolean(screenshot.image && screenshot.image.trim()),
            )
            .map((screenshot) => (
              <figure class="case-study-gallery__item">
                <CaseStudyImage
                  src={screenshot.image}
                  alt={screenshot.title}
                  triggerClass="case-study-gallery__trigger"
                  imageClass="case-study-gallery__image"
                  loading="lazy"
                />
                <figcaption class="case-study-gallery__caption">
                  {screenshot.title}
                </figcaption>
              </figure>
            ))}
        </div>
      </section>
    )
  }

  {
    caseStudy.architecture && (
      <section class="mt-16 border-t border-[#ffffff10] pt-12">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Technical architecture</p>
          <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">Built around the right stack</h2>
        </div>

        <div class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-6 md:p-8">
          <p class="mb-8 text-lg leading-relaxed text-[var(--white-icon)]">
            {caseStudy.architecture.description}
          </p>

          <div class="grid gap-5 md:grid-cols-3">
            {caseStudy.architecture.items.map((item) => (
              <div class="rounded-2xl border border-[#ffffff10] bg-[#101010] p-5">
                <h3 class="text-lg font-medium text-[var(--white)]">{item.name}</h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {item.technologies.map((technology) => (
                    <span class="rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-2.5 py-1 text-xs text-[var(--white-icon)]">
                      {technology}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    caseStudy.challenges?.length > 0 && (
      <section class="mt-16 border-t border-[#ffffff10] pt-12">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Challenges & engineering decisions</p>
          <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">Decision-making behind the build</h2>
        </div>

        <div class="space-y-5">
          {caseStudy.challenges.map((item) => (
            <article class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-6">
              <h3 class="text-xl font-medium text-[var(--white)]">{item.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-[var(--white-icon)]">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-16 border-t border-[#ffffff10] pt-12">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
      {caseStudy.result.title}
    </p>
    <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">Outcome</h2>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[var(--white-icon)]">
      {caseStudy.result.description}
    </p>
  </section>

  <section class="mt-16 border-t border-[#ffffff10] pt-12">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">
      {caseStudy.learnings.title}
    </p>
    <h2 class="mt-3 text-3xl font-medium text-[var(--white)] md:text-4xl">Takeaways</h2>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[var(--white-icon)]">
      {caseStudy.learnings.description}
    </p>
  </section>

  <section class="mt-20 border-t border-[#ffffff10] pt-12">
    <div class="rounded-2xl border border-[#ffffff10] bg-[#111111] p-8 text-center md:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--sec)]">Have a similar project in mind?</p>
      <h2 class="mt-4 text-3xl font-medium text-[var(--white)] md:text-4xl">Let's build it.</h2>
      <a
        href="/#contact"
        class="mt-7 inline-flex items-center justify-center rounded-full bg-[var(--white-icon-tr)] px-6 py-3 text-sm font-medium text-[var(--white)] transition-colors hover:bg-[var(--white-icon-tr)]"
      >
        Start a project
      </a>
    </div>
  </section>

  <dialog
    id="case-study-lightbox"
    class="case-study-lightbox"
    aria-label="Enlarged case-study image"
  >
    <button
      type="button"
      class="case-study-lightbox__close"
      aria-label="Close image"
      data-lightbox-close
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <div class="case-study-lightbox__controls" aria-label="Image zoom controls">
      <button type="button" aria-label="Zoom out" data-zoom-out disabled>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <button type="button" aria-label="Reset zoom" data-zoom-reset disabled>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M4 12a8 8 0 1 0 2.34-5.66L4 8.67M4 4v4.67h4.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" aria-label="Zoom in" data-zoom-in disabled>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <img
      class="case-study-lightbox__image"
      data-lightbox-image
      alt=""
      draggable="false"
    />
  </dialog>
</section>

<style>
  .case-study-gallery {
    column-gap: clamp(0.75rem, 1.25vw, 1.25rem);
    columns: 1;
  }

  .case-study-gallery__item {
    display: inline-block;
    width: 100%;
    margin: 0 0 clamp(0.75rem, 1.25vw, 1.25rem);
    break-inside: avoid;
    overflow: hidden;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.25rem;
    background: #111111;
    box-shadow: 0 2px 18px rgb(0 0 0 / 10%);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .case-study-gallery__trigger {
    display: block;
    width: 100%;
    overflow: hidden;
    background: #111111;
  }

  .case-study-gallery__image {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    object-fit: contain;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .case-study-gallery__item:hover,
  .case-study-gallery__item:focus-within {
    border-color: rgb(255 255 255 / 18%);
  }

  .case-study-gallery__trigger:hover .case-study-gallery__image,
  .case-study-gallery__trigger:focus-visible .case-study-gallery__image {
    transform: scale(1.02);
    filter: brightness(1.02);
  }

  .case-study-gallery__caption {
    border-top: 1px solid var(--white-icon-tr);
    padding: 0.875rem 1rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--white-icon);
  }

  @media (min-width: 640px) {
    .case-study-gallery {
      columns: 2;
    }
  }

  @media (min-width: 980px) {
    .case-study-gallery {
      columns: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study-gallery__item,
    .case-study-gallery__image,
    .case-study-gallery__trigger {
      transition: none;
    }
  }
</style>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>(
    "#case-study-lightbox",
  );
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    "[data-lightbox-image]",
  );
  const closeButton = lightbox?.querySelector<HTMLButtonElement>(
    "[data-lightbox-close]",
  );
  const zoomInButton = lightbox?.querySelector<HTMLButtonElement>(
    "[data-zoom-in]",
  );
  const zoomOutButton = lightbox?.querySelector<HTMLButtonElement>(
    "[data-zoom-out]",
  );
  const resetZoomButton = lightbox?.querySelector<HTMLButtonElement>(
    "[data-zoom-reset]",
  );

  if (
    lightbox &&
    lightboxImage &&
    closeButton &&
    zoomInButton &&
    zoomOutButton &&
    resetZoomButton
  ) {
    const minZoom = 1;
    const maxZoom = 4;
    const zoomStep = 1.25;
    let zoom = minZoom;
    let panX = 0;
    let panY = 0;
    let fitWidth = 0;
    let fitHeight = 0;
    let activeImage = false;
    let resizeFrame = 0;
    const pointers = new Map<number, { x: number; y: number }>();
    let dragStart: { x: number; y: number; panX: number; panY: number } | null =
      null;
    let pinchDistance = 0;

    let previousFocus: HTMLElement | null = null;
    let previousBodyOverflow = "";
    let previousRootOverflow = "";

    const clampPan = () => {
      const availableWidth = lightbox.clientWidth - 32;
      const availableHeight = lightbox.clientHeight - 144;
      const maxX = Math.max((fitWidth * zoom - availableWidth) / 2, 0);
      const maxY = Math.max((fitHeight * zoom - availableHeight) / 2, 0);
      panX = Math.max(-maxX, Math.min(maxX, panX));
      panY = Math.max(-maxY, Math.min(maxY, panY));
    };

    const renderZoom = () => {
      clampPan();
      lightboxImage.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
      lightboxImage.style.cursor = zoom > minZoom ? "grab" : "zoom-in";
      zoomInButton.disabled = zoom >= maxZoom;
      zoomOutButton.disabled = zoom <= minZoom;
      resetZoomButton.disabled = zoom <= minZoom;
      lightbox.dataset.zoom = `${zoom.toFixed(2)}x`;
    };

    const resetZoom = () => {
      zoom = minZoom;
      panX = 0;
      panY = 0;
      renderZoom();
    };

    const measureFit = () => {
      if (!activeImage || !lightboxImage.naturalWidth) return;

      const maxWidth = lightbox.clientWidth - 32;
      const maxHeight = lightbox.clientHeight - 144;
      const scaleToFit = Math.min(
        maxWidth / lightboxImage.naturalWidth,
        maxHeight / lightboxImage.naturalHeight,
        1,
      );
      fitWidth = lightboxImage.naturalWidth * scaleToFit;
      fitHeight = lightboxImage.naturalHeight * scaleToFit;
      lightboxImage.style.width = `${fitWidth}px`;
      lightboxImage.style.height = `${fitHeight}px`;
      resetZoom();
    };

    const zoomAt = (nextZoom: number, clientX?: number, clientY?: number) => {
      const boundedZoom = Math.max(minZoom, Math.min(maxZoom, nextZoom));
      if (boundedZoom === zoom) return;

      if (clientX !== undefined && clientY !== undefined) {
        const bounds = lightbox.getBoundingClientRect();
        const offsetX = clientX - (bounds.left + bounds.width / 2);
        const offsetY = clientY - (bounds.top + bounds.height / 2);
        panX = offsetX - ((offsetX - panX) * boundedZoom) / zoom;
        panY = offsetY - ((offsetY - panY) * boundedZoom) / zoom;
      }

      zoom = boundedZoom;
      renderZoom();
    };

    const handleResize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(measureFit);
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLButtonElement>(
        "[data-case-study-image]",
      );
      if (trigger) {
        const image = trigger.querySelector<HTMLImageElement>("img");
        if (!image || lightbox.open) return;

        previousFocus = trigger;
        previousBodyOverflow = document.body.style.overflow;
        previousRootOverflow = document.documentElement.style.overflow;
        activeImage = true;
        pointers.clear();
        dragStart = null;

        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        lightbox.showModal();
        window.addEventListener("resize", handleResize);
        closeButton.focus();
        if (lightboxImage.complete) measureFit();
        return;
      }

      if (target === lightbox) lightbox.close();
    });

    lightbox.addEventListener("close", () => {
      activeImage = false;
      pointers.clear();
      dragStart = null;
      lightboxImage.style.transform = "";
      lightboxImage.style.width = "";
      lightboxImage.style.height = "";
      zoom = minZoom;
      panX = 0;
      panY = 0;
      zoomInButton.disabled = true;
      zoomOutButton.disabled = true;
      resetZoomButton.disabled = true;
      delete lightbox.dataset.zoom;
      cancelAnimationFrame(resizeFrame);
      window.removeEventListener("resize", handleResize);
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.style.overflow = previousRootOverflow;
      previousFocus?.focus({ preventScroll: true });
      previousFocus = null;
    });
    lightboxImage.addEventListener("load", measureFit);
    lightboxImage.addEventListener("load", measureFit);

    document.addEventListener("keydown", (event) => {
      if (!lightbox.open) return;

      if (event.key === "Escape") {
        event.preventDefault();
        lightbox.close();
        return;
      }

      const target = event.target;
      const isEditing =
        target instanceof HTMLElement &&
        (target.isContentEditable ||
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target instanceof HTMLSelectElement);
      if (isEditing) return;

      if (event.key === "+" || event.key === "=") {
        event.preventDefault();
        zoomAt(zoom * zoomStep);
      } else if (event.key === "-") {
        event.preventDefault();
        zoomAt(zoom / zoomStep);
      } else if (event.key === "0") {
        event.preventDefault();
        resetZoom();
      }
    });

    closeButton.addEventListener("click", () => lightbox.close());
    zoomInButton.addEventListener("click", () => zoomAt(zoom * zoomStep));
    zoomOutButton.addEventListener("click", () => zoomAt(zoom / zoomStep));
    resetZoomButton.addEventListener("click", resetZoom);

    lightboxImage.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        zoomAt(
          event.deltaY < 0 ? zoom * zoomStep : zoom / zoomStep,
          event.clientX,
          event.clientY,
        );
      },
      { passive: false },
    );

    lightboxImage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      event.preventDefault();
      lightboxImage.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

      if (pointers.size === 1 && zoom > minZoom) {
        dragStart = { x: event.clientX, y: event.clientY, panX, panY };
        lightboxImage.classList.add("is-dragging");
      } else if (pointers.size === 2) {
        const [first, second] = [...pointers.values()];
        pinchDistance = Math.hypot(second.x - first.x, second.y - first.y);
        dragStart = null;
      }
    });

    lightboxImage.addEventListener("pointermove", (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

      if (pointers.size >= 2) {
        const [first, second] = [...pointers.values()];
        const distance = Math.hypot(second.x - first.x, second.y - first.y);
        if (pinchDistance > 0) {
          const midpointX = (first.x + second.x) / 2;
          const midpointY = (first.y + second.y) / 2;
          zoomAt(
            zoom * (distance / pinchDistance),
            midpointX,
            midpointY,
          );
        }
        pinchDistance = distance;
      } else if (dragStart && zoom > minZoom) {
        panX = dragStart.panX + event.clientX - dragStart.x;
        panY = dragStart.panY + event.clientY - dragStart.y;
        renderZoom();
      }
    });

    const finishPointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinchDistance = 0;
      if (pointers.size === 0) {
        dragStart = null;
        lightboxImage.classList.remove("is-dragging");
      } else if (pointers.size === 1 && zoom > minZoom) {
        const [remaining] = [...pointers.values()];
        dragStart = {
          x: remaining.x,
          y: remaining.y,
          panX,
          panY,
        };
      }
    };

    lightboxImage.addEventListener("pointerup", finishPointer);
    lightboxImage.addEventListener("pointercancel", finishPointer);
  }
</script>

